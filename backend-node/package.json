{
  "name": "caremanager-backend-node",
  "version": "1.0.0",
  "description": "Node.js + Express + TypeScript API for Healthcare Appointment Manager",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
