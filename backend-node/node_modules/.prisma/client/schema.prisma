datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  BOOKED
  CANCELLED
  COMPLETED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  password                 String
  name                     String
  role                     Role      @default(PATIENT)
  isVerified               Boolean   @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?

  // Google Calendar OAuth credentials
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile DoctorProfile?
  appointments  Appointment[]        @relation("PatientAppointments")
  reminders     MedicationReminder[]
  holds         SlotHold[]           @relation("UserHolds")
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialisation String
  workingHours   Json? // Stores weekly schedule: { monday: [{start: "09:00", end: "13:00"}, {start: "14:00", end: "17:00"}], ... }
  slotDuration   Int      @default(30) // In minutes
  isActive       Boolean  @default(true) // For activating/deactivating
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  leaves       DoctorLeave[]
  appointments Appointment[] @relation("DoctorAppointments")
}

model DoctorLeave {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime // Date only (HH:MM set to 00:00)
  reason    String?
  createdAt DateTime      @default(now())

  @@unique([doctorId, date])
}

model SlotHold {
  id        String   @id @default(uuid())
  doctorId  String
  dateTime  DateTime
  expiresAt DateTime
  userId    String
  user      User     @relation("UserHolds", fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("HELD") // HELD, EXPIRED, RELEASED, BOOKED
  active    Boolean? // true when active hold, null when expired/released

  createdAt DateTime @default(now())

  @@unique([doctorId, dateTime, active])
}

model Appointment {
  id                    String            @id @default(uuid())
  patientId             String
  patient               User              @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId              String
  doctor                DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  dateTime              DateTime // Start time
  endTime               DateTime // End time
  status                AppointmentStatus @default(BOOKED)
  active                Boolean? // true when BOOKED, null when CANCELLED/COMPLETED
  symptoms              String
  googleCalendarEventId String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  preVisitSummary PreVisitSummary?
  consultation    Consultation?

  @@unique([doctorId, dateTime, active])
}

model PreVisitSummary {
  id                 String        @id @default(uuid())
  appointmentId      String        @unique
  appointment        Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  urgency            UrgencyLevel?
  chiefComplaint     String?
  suggestedQuestions Json? // String[]
  status             String        @default("PENDING") // PENDING, SUCCESS, FAILED
  errorMessage       String?
  createdAt          DateTime      @default(now())
}

model Consultation {
  id                     String            @id @default(uuid())
  appointmentId          String            @unique
  appointment            Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  notes                  String
  followUpInfo           String?
  prescriptionString     String?           @map("prescription")
  prescription           Prescription?
  postVisitSummaryString String?           @map("postVisitSummary")
  postVisitSummary       PostVisitSummary?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model Prescription {
  id             String             @id @default(uuid())
  consultationId String             @unique
  consultation   Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  items          PrescriptionItem[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineName   String
  dosage         String
  frequency      String
  duration       String
  instructions   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PostVisitSummary {
  id                     String       @id @default(uuid())
  consultationId         String       @unique
  consultation           Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientFriendlySummary String?
  medicationSchedule     Json? // Structured timing info
  followUpSteps          String?
  status                 String       @default("PENDING") // PENDING, SUCCESS, FAILED
  errorMessage           String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model MedicationReminder {
  id               String   @id @default(uuid())
  patientId        String
  patient          User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicineName     String
  dosage           String
  frequency        String // e.g. "Once daily", "Twice daily"
  nextReminderTime DateTime
  status           String   @default("ACTIVE") // ACTIVE, SENT, INACTIVE
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OutboxNotification {
  id            String    @id @default(uuid())
  type          String // EMAIL, CALENDAR
  action        String // e.g. "SEND_EMAIL", "CREATE_EVENT", "CANCEL_EVENT"
  payload       Json
  attempts      Int       @default(0)
  status        String    @default("PENDING") // PENDING, PROCESSING, SENT, FAILED
  errorMessage  String?
  nextRetryTime DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
