# Port for the Node.js Express server to listen on
PORT=5000

# MongoDB Connection String (from within the docker network or local host)
MONGO_URI=mongodb://mongodb:27017/medguide

# Redis Connection URL
REDIS_URL=redis://redis:6379

# JSON Web Token Secret for user session signing and verification
JWT_SECRET=your_super_secure_jwt_secret_here

# Groq Cloud API Key for AI predictions (should be rotated periodically)
GROQ_API_KEY=your_groq_api_key_here

# Controls whether AI errors result in failures or fallbacks
STRICT_AI_MODE=true

# Allowed CORS Origin for Frontend
FRONTEND_URL=http://localhost:3000

# Python ML prediction service URL (accessible internally inside docker)
ML_SERVICE_URL=http://backend-python:8000

# SMTP Server Configurations for Email Verification (Optional in Dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@medguide.ai

# Resend API Key for Email Delivery (Optional)
RESEND_API_KEY=your_resend_api_key_here

