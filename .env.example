# CareManager Environment Configuration Template
# DO NOT place real secrets in this file. Copy to .env and fill in environment-specific values.

PORT=5051
DATABASE_URL="postgresql://user:password@localhost:5432/caremanager?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="your_jwt_secret_key_here"

# AI Provider Configuration (GROQ, GEMINI, or MOCK)
LLM_PROVIDER="GROQ"
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
STRICT_AI_MODE=false

# Application URLs
FRONTEND_URL="http://localhost:3002"
VITE_API_URL="http://localhost:5051"

# Email Configuration (Optional - Nodemailer / Resend)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@caremanager.health"
RESEND_API_KEY=""
